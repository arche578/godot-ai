extends Node

## Drives a character's AnimationTree from the game (generated by
## character_anim_setup). It only reads the body: the player and enemy
## scripts are not changed.
##
##   movement speed  -> locomotion blend (idle / walk / run, strafes if any)
##   no weapon       -> unarmed idle / walk / run, when the library has them
##   AI state        -> aim pose while the state is in `aim_states`
##   died            -> death clip, then the pose holds
##   health drops    -> hit reaction (upper body)
##   weapon fired    -> fire (upper body); reload_started -> reload
##   dodged          -> dodge roll; attack_started -> attack (melee)
##
## The weapon mount follows the hand bone while the game runs
## (`weapon_follow`), so the gun sits in the hand; aiming and shots still
## come from the weapon's own Muzzle.
##
## Free to edit: this file was copied into your project and is yours now.

@export var body_path: NodePath = ^".."
@export var animation_tree_path: NodePath = ^"../AnimationTree"
## Clips in the tree (character_anim_setup fills this in).
@export var roles := PackedStringArray()

@export_group("Locomotion")
## Speed (m/s) the walk and run clips were made for.
@export var walk_speed := 1.6
@export var run_speed := 4.0
## Below this the character stands.
@export var idle_threshold := 0.15
## Locomotion blend uses strafe/back clips (BlendSpace2D) instead of speed only.
@export var directional := false
@export var blend_smoothing := 10.0
## Play walk/run faster when moving faster than the clip (feet do not slide).
@export var scale_with_speed := true

@export_group("States")
## get_state_name() values that hold the aim pose (enemies).
@export var aim_states := PackedStringArray(["ATTACK", "CHASE"])
## Hold the aim pose whenever the body has a weapon (the player).
@export var aim_when_armed := true
## auto: the unarmed clips while the body has no weapon (the player, e.g. in
## the hideout; AI bodies stay armed). armed/unarmed: always that set.
@export_enum("auto", "armed", "unarmed") var stance: String = "auto"

@export_group("Weapon in hand")
@export_enum("hand_position", "hand", "none") var weapon_follow: String = "hand_position"
@export var weapon_mount_path: NodePath = ^"../Aim/WeaponMount"
@export var hand_bone: StringName = &"RightHand"
## Offset from the hand, in the body's space (meters), or in the hand
## bone's own space with grip_in_hand_space.
@export var grip_offset := Vector3.ZERO
## grip_offset turns with the hand bone, so a clip that twists the wrist
## (rifle walk) keeps the palm on the grip; the gun still points where it aims.
@export var grip_in_hand_space := false
## weapon_follow = hand: extra turn of the weapon relative to the hand.
@export var grip_rotation_degrees := Vector3.ZERO

var _body: Node3D = null
var _tree: AnimationTree = null
var _mount: Node3D = null
var _skeleton: Skeleton3D = null
var _hand := -1
var _weapon: Node = null
var _last_health := -1.0
var _dead := false
var _blend := Vector2.ZERO
var _aim := 0.0
var _unarmed := 0.0


func _ready() -> void:
	_body = get_node_or_null(body_path) as Node3D
	_tree = get_node_or_null(animation_tree_path) as AnimationTree
	_mount = get_node_or_null(weapon_mount_path) as Node3D
	if _body == null or _tree == null:
		push_warning("CharacterAnimator: body or AnimationTree not found; animations stay off.")
		set_process(false)
		return
	## Run after the AnimationTree so the hand is where this frame put it.
	process_priority = _tree.process_priority + 1
	_tree.active = true
	_skeleton = _find_skeleton()
	if _skeleton != null:
		_hand = _skeleton.find_bone(hand_bone)
	for spec in [["died", _on_died], ["health_changed", _on_health_changed], ["dodged", _on_dodged], ["attack_started", _on_attack_started]]:
		if _body.has_signal(spec[0]):
			_body.connect(spec[0], spec[1])
	_set_param("life/transition_request", "alive")


func _process(delta: float) -> void:
	if _body == null or _tree == null:
		return
	_watch_weapon()
	if not _dead:
		_update_locomotion(delta)
		_update_aim(delta)
	_follow_hand()


func has_role(role: String) -> bool:
	return roles.has(role)


## Plays a one-shot clip by role (fire, reload, hit, dodge, attack).
func play(role: String, duration := 0.0) -> void:
	if _dead or not has_role(role):
		return
	if duration > 0.0:
		var lib_anim := _clip(role)
		if lib_anim != null and lib_anim.length > 0.0:
			_set_param(role + "_speed/scale", clampf(lib_anim.length / duration, 0.25, 4.0))
	_set_param(role + "/request", AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE)


# --- body and weapon ----------------------------------------------------------

func _on_died() -> void:
	_dead = true
	for role in ["fire", "reload", "hit", "dodge", "attack"]:
		if has_role(role):
			_set_param(role + "/request", AnimationNodeOneShot.ONE_SHOT_REQUEST_ABORT)
	if has_role("death"):
		_set_param("life/transition_request", "dead")
	else:
		## No death clip: at least stop walking.
		_blend = Vector2.ZERO
		_set_param("locomotion/blend_position", _blend if directional else 0.0)


func _on_health_changed(current: float, _maximum: float) -> void:
	if _last_health >= 0.0 and current < _last_health and current > 0.0:
		play("hit")
	_last_health = current


func _on_dodged(_direction: Vector3) -> void:
	var duration: float = _body.get("dodge_duration") if _body.get("dodge_duration") != null else 0.0
	play("dodge", duration)


func _on_attack_started(_target: Node3D) -> void:
	play("attack")


func _on_fired(_ammo_left: int) -> void:
	play("fire")


func _on_reload_started(duration: float) -> void:
	play("reload", duration)


func _watch_weapon() -> void:
	var weapon: Node = _body.get_weapon() if _body.has_method("get_weapon") else null
	if weapon == _weapon:
		return
	if is_instance_valid(_weapon):
		for spec in [["fired", _on_fired], ["reload_started", _on_reload_started]]:
			if _weapon.is_connected(spec[0], spec[1]):
				_weapon.disconnect(spec[0], spec[1])
	_weapon = weapon
	if _weapon != null:
		for spec in [["fired", _on_fired], ["reload_started", _on_reload_started]]:
			if _weapon.has_signal(spec[0]):
				_weapon.connect(spec[0], spec[1])


# --- locomotion and aim -------------------------------------------------------

func _update_locomotion(delta: float) -> void:
	var velocity: Vector3 = _body.get("velocity") if _body.get("velocity") is Vector3 else Vector3.ZERO
	velocity.y = 0.0
	var speed := velocity.length()
	if speed < idle_threshold:
		speed = 0.0
		velocity = Vector3.ZERO
	var target := Vector2(0.0, speed)
	if directional:
		## Velocity in the model's frame: x right, y forward (-Z).
		var basis := _model_basis()
		var local := basis.inverse() * velocity
		target = Vector2(local.x, -local.z)
	var k := 1.0 if blend_smoothing <= 0.0 else 1.0 - exp(-blend_smoothing * delta)
	_blend = _blend.lerp(target, k)
	_set_param("locomotion/blend_position", _blend if directional else _blend.y)
	_update_stance(delta)
	if scale_with_speed:
		var top := run_speed if has_role("run") else walk_speed
		_set_param("loco_speed/scale", clampf(speed / top, 1.0, 2.0) if top > 0.0 and speed > top else 1.0)


func is_unarmed() -> bool:
	if stance == "auto":
		return _weapon == null and not _body.has_method("get_state_name")
	return stance == "unarmed"


func _update_stance(delta: float) -> void:
	if not (has_role("unarmed_idle") or has_role("unarmed_walk") or has_role("unarmed_run")):
		return
	_unarmed = move_toward(_unarmed, 1.0 if is_unarmed() else 0.0, delta * 5.0)
	_set_param("stance/blend_amount", _unarmed)
	## Unarmed locomotion is speed only (no strafe clips).
	_set_param("unarmed_locomotion/blend_position", _blend.length() if directional else _blend.y)


func _update_aim(delta: float) -> void:
	if not has_role("aim"):
		return
	var want := 0.0
	if is_unarmed():
		want = 0.0
	elif _body.has_method("get_state_name"):
		want = 1.0 if aim_states.has(String(_body.get_state_name())) else 0.0
	elif aim_when_armed and _weapon != null:
		want = 1.0
	_aim = move_toward(_aim, want, delta * 5.0)
	_set_param("aim/blend_amount", _aim)


# --- weapon in hand -----------------------------------------------------------

func _follow_hand() -> void:
	if weapon_follow == "none" or _mount == null or _skeleton == null or _hand < 0:
		return
	var hand := _skeleton.global_transform * _skeleton.get_bone_global_pose(_hand)
	var offset := hand.basis.orthonormalized() * grip_offset if grip_in_hand_space else _body.global_basis * grip_offset
	_mount.global_position = hand.origin + offset
	if weapon_follow == "hand":
		var turn := Basis.from_euler(grip_rotation_degrees * (PI / 180.0))
		_mount.global_basis = (hand.basis.orthonormalized() * turn).scaled(_mount.global_basis.get_scale())


# --- helpers ------------------------------------------------------------------

func _set_param(name: String, value: Variant) -> void:
	var path := "parameters/" + name
	if _tree.get(path) != null:
		_tree.set(path, value)


func _clip(role: String) -> Animation:
	for lib_name in _tree.get_animation_library_list():
		var lib := _tree.get_animation_library(lib_name)
		if lib != null and lib.has_animation(role):
			return lib.get_animation(role)
	return null


func _model_basis() -> Basis:
	var model := _tree.get_node_or_null(_tree.root_node) as Node3D
	return model.global_basis.orthonormalized() if model != null else _body.global_basis.orthonormalized()


func _find_skeleton() -> Skeleton3D:
	var model := _tree.get_node_or_null(_tree.root_node)
	if model == null:
		return null
	var unique := model.get_node_or_null(^"%GeneralSkeleton") as Skeleton3D
	if unique != null:
		return unique
	var stack: Array[Node] = [model]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		if n is Skeleton3D:
			return n
		for c in n.get_children():
			stack.append(c)
	return null
