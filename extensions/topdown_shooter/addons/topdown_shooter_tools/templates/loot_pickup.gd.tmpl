extends Area3D

## A dropped item on the ground (generated by loot_table_edit). It builds
## its own collision, a box colored by rarity and a name label, bobs in
## place, and is collected when a body in `collector_group` touches it.
##
## Collecting calls `add_item(item, count)` on the collector when it has
## that method (an inventory). If add_item returns false (full), the pickup
## stays. Without the method the pickup is collected anyway and only the
## `picked_up` signal reports it.
##
## Free to edit: this file was copied into your project and is yours now.

signal picked_up(collector: Node, item_id: String, count: int)

const RARITY_COLORS := {
	"common": Color("{{rarity_color:common}}"),
	"uncommon": Color("{{rarity_color:uncommon}}"),
	"rare": Color("{{rarity_color:rare}}"),
	"epic": Color("{{rarity_color:epic}}"),
	"legendary": Color("{{rarity_color:legendary}}"),
}

@export var item_id := ""
@export var count := 1
@export var item: Resource
@export var collector_group: StringName = &"player"
## Seconds after spawning before it can be collected.
@export var pickup_delay := 0.4
@export var radius := 0.6
@export var bob_height := 0.12
@export var hover_height := 0.35

var _age := 0.0
var _visual: Node3D


func _ready() -> void:
	add_to_group(&"loot_pickup")
	monitoring = true
	monitorable = false
	if get_child_count() == 0:
		_build()
		_apply_model()
	_visual = get_node_or_null(^"Visual") as Node3D
	body_entered.connect(_on_body_entered)


func _process(delta: float) -> void:
	_age += delta
	if _visual != null:
		_visual.position.y = hover_height + sin(_age * 3.0) * bob_height
		_visual.rotate_y(delta * 1.5)
	if _age >= pickup_delay and _age - delta < pickup_delay:
		for body in get_overlapping_bodies():
			if _try_collect(body):
				return


func get_display_name() -> String:
	var label := item_id
	if item != null and String(item.get("display_name")) != "":
		label = String(item.get("display_name"))
	return label if count <= 1 else "%s x%d" % [label, count]


func _on_body_entered(body: Node) -> void:
	if _age >= pickup_delay:
		_try_collect(body)


func _try_collect(body: Node) -> bool:
	if not body.is_in_group(collector_group) or is_queued_for_deletion():
		return false
	if body.has_method("add_item"):
		var accepted: Variant = body.add_item(item if item != null else item_id, count)
		if accepted is bool and not accepted:
			return false
	picked_up.emit(body, item_id, count)
	queue_free()
	return true


func _build() -> void:
	var shape := CollisionShape3D.new()
	var sphere := SphereShape3D.new()
	sphere.radius = radius
	shape.shape = sphere
	shape.position.y = hover_height
	add_child(shape)

	var visual := Node3D.new()
	visual.name = "Visual"
	add_child(visual)
	var mesh := MeshInstance3D.new()
	var box := BoxMesh.new()
	box.size = Vector3(0.3, 0.3, 0.3)
	var mat := StandardMaterial3D.new()
	var rarity := String(item.get("rarity")) if item != null else "common"
	mat.albedo_color = RARITY_COLORS.get(rarity, RARITY_COLORS.common)
	mat.emission_enabled = true
	mat.emission = mat.albedo_color * 0.4
	box.material = mat
	mesh.mesh = box
	visual.add_child(mesh)

	var label := Label3D.new()
	label.text = get_display_name()
	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	label.no_depth_test = true
	label.font_size = 28
	label.pixel_size = 0.01
	label.outline_size = 6
	label.position.y = hover_height + 0.45
	add_child(label)


# --- item model (asset pipeline) ---------------------------------------------

## Largest side in meters of the item's 3D model (item.model) on the ground.
@export var model_size := 0.45


## Shows item.model instead of the colored box, with a glow in the rarity
## color under it. Does nothing when the item has no model.
func _apply_model() -> void:
	var visual := get_node_or_null(^"Visual") as Node3D
	var path := ""
	if item != null and item.get("model") is String:
		path = String(item.get("model"))
	if visual == null or path.is_empty() or not ResourceLoader.exists(path):
		return
	var packed := load(path) as PackedScene
	var model: Node3D = packed.instantiate() as Node3D if packed != null else null
	if model == null:
		return
	var box := _model_bounds(model, model)
	var longest := maxf(box.size.x, maxf(box.size.y, box.size.z))
	if longest <= 0.0001:
		model.free()
		return
	for child in visual.get_children():
		if child is MeshInstance3D:
			child.visible = false
	var k := model_size / longest
	model.scale = Vector3(k, k, k)
	model.position = -box.get_center() * k
	model.name = "Model"
	visual.add_child(model)

	var rarity := String(item.get("rarity")) if item.get("rarity") != null else "common"
	var color: Color = RARITY_COLORS.get(rarity, RARITY_COLORS.common)
	var glow := MeshInstance3D.new()
	glow.name = "Glow"
	var disc := CylinderMesh.new()
	disc.top_radius = maxf(0.2, model_size * 0.7)
	disc.bottom_radius = disc.top_radius
	disc.height = 0.01
	var mat := StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.albedo_color = Color(color, 0.35)
	disc.material = mat
	glow.mesh = disc
	glow.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	glow.position.y = 0.02
	add_child(glow)
	var light := OmniLight3D.new()
	light.name = "GlowLight"
	light.light_color = color
	light.light_energy = 0.6
	light.omni_range = 1.2
	light.position.y = hover_height
	add_child(light)


static func _model_bounds(node: Node, root: Node) -> AABB:
	var out := AABB()
	var first := true
	var stack: Array[Node] = [node]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		if n is VisualInstance3D:
			var xf := Transform3D.IDENTITY
			var p := n
			while p != null and p != root:
				if p is Node3D:
					xf = (p as Node3D).transform * xf
				p = p.get_parent()
			var b := xf * (n as VisualInstance3D).get_aabb()
			out = b if first else out.merge(b)
			first = false
		for c in n.get_children():
			stack.append(c)
	return out
