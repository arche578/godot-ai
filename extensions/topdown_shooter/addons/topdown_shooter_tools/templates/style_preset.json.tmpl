{
  "version": 1,
  "name": "default",
  "about": "Shared art direction for asset_generate / asset_pipeline. Every prompt gets the kind's line and the style line appended. Edit freely: this copy belongs to the project, so set the game's own art direction here; the addon ships only this neutral default. Original designs only: never recreate characters, maps or distinctive designs from existing games.",
  "style": "game-ready 3D asset, clean readable silhouette, PBR textures",
  "texture_style": "clean PBR materials, consistent lighting, readable detail",
  "negative": "text, letters, logo, watermark, brand name, trademark, signature, ground plane, pedestal, base, background scene, multiple objects, cartoon, chibi, low quality, blurry",
  "blocked_terms": ["logo", "trademark", "brand name"],
  "kinds": {
    "weapon": {
      "prompt": "single original firearm design, isolated object, side view silhouette that reads clearly from above",
      "target_polycount": 5000
    },
    "item": {
      "prompt": "single small loot object, isolated, centered, readable silhouette",
      "target_polycount": 2000
    },
    "prop": {
      "prompt": "modular environment prop for a top-down game, isolated, flat bottom, sits on the ground",
      "target_polycount": 5000
    },
    "character": {
      "prompt": "original character design, full body, A-pose, arms away from the body, neutral expression, isolated",
      "target_polycount": 15000
    }
  },
  "environment": {
    "about": "Used by environment_setup and swap_placeholder target=kit. Neutral defaults: set the game's own sky, fog, light and kit materials here. kit_materials take polyhaven_fetch names or res:// materials.",
    "hdri": "",
    "tonemap": "filmic",
    "exposure": 1.0,
    "ambient_energy": 1.0,
    "ssao": true,
    "fog": false,
    "fog_color": [0.7, 0.72, 0.75],
    "fog_density": 0.01,
    "volumetric_fog": false,
    "volumetric_fog_density": 0.03,
    "sun_color": [1.0, 1.0, 1.0],
    "sun_energy": 1.0,
    "sun_pitch": -55,
    "sun_yaw": 30,
    "kit_materials": {"wall": "", "floor": "", "cover": "", "trim": ""}
  },
  "provider_options": {
    "meshy": {},
    "tripo": {}
  }
}
