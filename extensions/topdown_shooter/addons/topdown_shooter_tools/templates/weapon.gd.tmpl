extends Node3D

## Weapon logic (generated by weapon_create).
##
## Reads its stats from `data` (a weapon data .tres). try_fire(aim_point)
## shoots from the Muzzle marker toward the aim point on the horizontal
## plane, either as instant rays (hitscan) or as spawned projectiles.
## Damage goes to the first node in the hit collider's ancestry that has
## take_damage(amount, info).
##
## The muzzle usually sticks out in front of the shooter, so when the
## shooter hugs a wall the muzzle is already on the far side of it. Every
## shot therefore first checks the stretch from the shooter's body to the
## muzzle; anything in that gap (a wall, a crate) takes the shot instead.
##
## Free to edit: this file was copied into your project and is yours now.

signal fired(ammo_left: int)
signal hit(target: Node, position: Vector3, damage: float)
signal empty
signal reload_started(duration: float)
signal reload_finished

@export var data: Resource
@export var muzzle_path: NodePath = ^"Muzzle"
## Keep shots level with the muzzle (top-down shooters usually want this).
@export var flatten_aim := true

var ammo := 0

var _cooldown := 0.0
var _reload_left := 0.0


func _ready() -> void:
	if data != null:
		ammo = data.magazine_size


func _physics_process(delta: float) -> void:
	_cooldown = maxf(_cooldown - delta, 0.0)
	if _reload_left > 0.0:
		_reload_left -= delta
		if _reload_left <= 0.0:
			_reload_left = 0.0
			ammo = data.magazine_size
			reload_finished.emit()


func is_automatic() -> bool:
	return data != null and data.automatic


func is_reloading() -> bool:
	return _reload_left > 0.0


func can_fire() -> bool:
	return data != null and _cooldown <= 0.0 and not is_reloading() and ammo > 0


## Fires one shot toward aim_point. Returns true when a shot was fired.
func try_fire(aim_point: Vector3) -> bool:
	if data == null or _cooldown > 0.0 or is_reloading():
		return false
	if ammo <= 0:
		empty.emit()
		if data.auto_reload:
			reload()
		return false
	ammo -= 1
	_cooldown = 1.0 / maxf(data.fire_rate, 0.01)

	var origin := _muzzle_position()
	var base_dir := aim_point - origin
	if flatten_aim:
		base_dir.y = 0.0
	if base_dir.length_squared() < 0.0001:
		base_dir = -global_basis.z
		if flatten_aim:
			base_dir.y = 0.0
	base_dir = base_dir.normalized()

	var blocked := _muzzle_blocker(origin)
	for _pellet in maxi(data.pellets, 1):
		var half_spread := deg_to_rad(data.spread_degrees) * 0.5
		var dir := base_dir.rotated(Vector3.UP, randf_range(-half_spread, half_spread))
		if not blocked.is_empty():
			apply_hit(blocked.collider, blocked.position, dir)
			if show_tracers:
				_spawn_tracer(origin, blocked.position)
		elif data.fire_mode == "projectile" and data.projectile_scene != null:
			_spawn_projectile(origin, dir)
		else:
			_fire_ray(origin, dir)
	fired.emit(ammo)
	return true


## Starts a reload. Returns false when already reloading or full.
func reload() -> bool:
	if data == null or is_reloading() or ammo >= data.magazine_size:
		return false
	_reload_left = maxf(data.reload_time, 0.001)
	reload_started.emit(data.reload_time)
	return true


func _fire_ray(origin: Vector3, dir: Vector3) -> void:
	var space := get_world_3d().direct_space_state
	var query := PhysicsRayQueryParameters3D.create(origin, origin + dir * data.max_range, data.collision_mask, _shooter_rids())
	var result := space.intersect_ray(query)
	if show_tracers:
		var end: Vector3 = result.position if not result.is_empty() else origin + dir * data.max_range
		_spawn_tracer(origin, end)
	if result.is_empty():
		return
	apply_hit(result.collider, result.position, dir)


## Hitscan rays are instant, so draw a short-lived streak to show the shot.
@export var show_tracers := true
@export var tracer_color := Color(1.0, 0.85, 0.4)
@export var tracer_width := 0.08
@export var tracer_lifetime := 0.1


func _spawn_tracer(from: Vector3, to: Vector3) -> void:
	var length := from.distance_to(to)
	if length < 0.05:
		return
	var mesh := BoxMesh.new()
	mesh.size = Vector3(tracer_width, tracer_width, length)
	var mat := StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.albedo_color = tracer_color
	mesh.material = mat
	var tracer := MeshInstance3D.new()
	tracer.mesh = mesh
	tracer.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	var host := get_tree().current_scene if get_tree().current_scene != null else get_tree().root
	host.add_child(tracer)
	tracer.global_position = (from + to) * 0.5
	tracer.look_at(to, Vector3.UP if absf((to - from).normalized().y) < 0.99 else Vector3.RIGHT)
	var tween := tracer.create_tween()
	tween.tween_property(mat, "albedo_color:a", 0.0, tracer_lifetime)
	tween.tween_callback(tracer.queue_free)


## Delivers this weapon's damage to `collider` (or the first ancestor that
## implements take_damage). Projectiles call this too.
func apply_hit(collider: Object, hit_position: Vector3, dir: Vector3) -> void:
	var receiver := collider as Node
	while receiver != null and not receiver.has_method("take_damage"):
		receiver = receiver.get_parent()
	if receiver != null:
		receiver.take_damage(data.damage, {
			"source": get_shooter(),
			"weapon": data.weapon_id,
			"position": hit_position,
			"direction": dir,
		})
	hit.emit(receiver if receiver != null else collider as Node, hit_position, data.damage)


func _spawn_projectile(origin: Vector3, dir: Vector3) -> void:
	var projectile: Node3D = data.projectile_scene.instantiate()
	var host := get_tree().current_scene if get_tree().current_scene != null else get_tree().root
	host.add_child(projectile)
	projectile.global_position = origin
	if projectile.has_method("setup"):
		projectile.setup(self, dir * data.projectile_speed, data.max_range, data.collision_mask, _shooter_rids())


## The physics body holding this weapon (usually the player), or null.
func get_shooter() -> Node:
	var node := get_parent()
	while node != null and not node is CollisionObject3D:
		node = node.get_parent()
	return node


func _shooter_rids() -> Array[RID]:
	var rids: Array[RID] = []
	var shooter := get_shooter() as CollisionObject3D
	if shooter != null:
		rids.append(shooter.get_rid())
	return rids


## What sits between the shooter's body and the muzzle (the ray result of
## intersect_ray), or {} when the muzzle is clear. The check starts at the
## shooter's center, raised to the muzzle's height.
func _muzzle_blocker(muzzle: Vector3) -> Dictionary:
	var shooter := get_shooter() as Node3D
	var start := shooter.global_position if shooter != null else global_position
	start.y = muzzle.y
	if start.distance_squared_to(muzzle) < 0.000001:
		return {}
	var query := PhysicsRayQueryParameters3D.create(start, muzzle, data.collision_mask, _shooter_rids())
	return get_world_3d().direct_space_state.intersect_ray(query)


func _muzzle_position() -> Vector3:
	var muzzle := get_node_or_null(muzzle_path) as Node3D
	return muzzle.global_position if muzzle != null else global_position
